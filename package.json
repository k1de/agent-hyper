{
    "name": "agent-hyper",
    "version": "2.0.0",
    "description": "HTTP/HTTPS proxy agents and a reusable HTTP/2 client transport for Node.js",
    "main": "index.js",
    "types": "index.d.ts",
    "files": [
        "*.js",
        "*.mjs",
        "*.d.ts"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "require": "./index.js",
            "import": "./index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "node --test test/*.test.cjs"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "agent",
        "http",
        "https",
        "proxy",
        "keep-alive",
        "tunnel"
    ],
    "author": "tish",
    "license": "MIT",
    "devDependencies": {
        "axios": "^1.21.1"
    }
}
